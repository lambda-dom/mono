cabal-version:      3.0
name:               mono
version:            0.1.0.0
synopsis:           Monomorphic versions of typeclasses Functor, Foldable and Traversable.
description:        Please see the README on GitHub at <https://github.com/lambda-dom/mono#readme>
category:           Data
homepage:           https://github.com/lambda-dom/mono#readme
author:             G. Rodrigues
license:            BSD-3-Clause
license-file:       LICENSE
maintainer:         grodrigues.math@gmail.com
copyright:          2025 G. Rodrigues
build-type:         Simple
tested-with:
    GHC == {9.10.3}
extra-doc-files:
    LICENSE
    README.md
    CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/lambda-dom/mono


common common-fields
    default-language: GHC2021
    build-depends:
        -- GHC >= 9.10
        base >=4.20 && <4.21,
        -- Libraries.
        bytestring >=0.12 && <0.13,
        text >=2.1 && <2.2,
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wmissing-deriving-strategies
        -- TODO: uncomment this when dependencies settled.
        -- -Wunused-packages
        -- Prepare for dependent types.
        -Wterm-variable-capture

library
    import:
        common-fields
    default-extensions:
        DerivingStrategies
        TypeFamilies
        FunctionalDependencies
    build-depends:
        -- Libraries.
        containers >=0.7 && <0.8,
        vector >=0.13 && <0.14,
    hs-source-dirs:
        src
    exposed-modules:
        Mono.Typeclasses.MonoFunctor
        Mono.Typeclasses.MonoPointed
        Mono.Typeclasses.MonoFoldable

test-suite mono-tests
    import:
        common-fields
    hs-source-dirs:
        tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    build-depends:
        mono,
        -- Libraries.
        tasty          >=1.5 && <1.6,
        hedgehog       >=1.5 && <1.6,
        tasty-hedgehog >=1.4 && <1.5
    other-modules:
        -- Lib.Gen
        -- Lib.MonoFunctor
        -- Lib.MonoPointed
        -- Lib.MonoFoldable
        -- Tests.Typeclasses.MonoFunctor
        -- Tests.Typeclasses.MonoPointed
        -- Tests.Typeclasses.MonoFoldable
